#include <Arduino.h>

// Pines de conexión del Joystick en la ESP32
const int PIN_JOY_X  = 34; // Eje X -> Base (joint_1)
const int PIN_JOY_Y  = 35; // Eje Y -> Brazo (joint_2)
const int PIN_JOY_SW = 32; // Botón -> Pinza (Gripper)

void setup() {
  // Inicialización de la comunicación serial
  Serial.begin(115200);

  // Configuración de la resolución ADC del ESP32 a 12 bits (0 a 4095)
  analogReadResolution(12);

  // Botón con resistencia Pull-Up interna
  pinMode(PIN_JOY_SW, INPUT_PULLUP);
}

void loop() {
  // Lectura de los potenciómetros del joystick
  int val_x = analogRead(PIN_JOY_X);
  int val_y = analogRead(PIN_JOY_Y);

  // Lectura del botón (0 al presionar, 1 al soltar)
  int val_btn = digitalRead(PIN_JOY_SW);
  int estado_pinza = (val_btn == LOW) ? 1 : 0;

  // Transmisión en formato CSV: "valX,valY,estadoPinza"
  Serial.print(val_x);
  Serial.print(",");
  Serial.print(val_y);
  Serial.print(",");
  Serial.println(estado_pinza);

  delay(20); // Envío constante a ~50 Hz
}
